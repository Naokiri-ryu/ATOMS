{
	# No ACME — all certs are internal/self-signed for intranet
}

# ─────── ROSTERING (HALAMAN UTAMA) ───────
{$MAIN_DOMAIN} {
	tls internal
	encode zstd gzip

	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	handle /api/* {
		reverse_proxy rostering-backend:80
	}

	handle {
		reverse_proxy rostering-frontend:80
	}
}

# ─────── MAINTENANCE ───────
{$MAINTENANCE_DOMAIN} {
	tls internal
	encode zstd gzip

	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	handle /api/* {
		reverse_proxy atoms-backend:80
	}

	handle {
		reverse_proxy atoms-frontend:80
	}
}

# ─────── SAKTI ───────
{$SAKTI_DOMAIN} {
	tls internal
	encode zstd gzip

	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	reverse_proxy sakti:80
}

# ─────── FALLBACK (IP ACCESS → ROSTERING) ───────
http:// {
	encode zstd gzip

	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	reverse_proxy rostering-frontend:80
}
