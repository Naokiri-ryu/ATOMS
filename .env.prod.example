HTTP_PORT=80
HTTPS_PORT=443
ACME_EMAIL=admin@example.com

# ─────── ROSTERING (HALAMAN UTAMA / MAIN) ───────
MAIN_DOMAIN=atoms.local
MAIN_PUBLIC_URL=https://atoms.local
MAIN_PUBLIC_API_URL=https://atoms.local/api
MAIN_CORS_ALLOWED_ORIGINS=https://atoms.local,https://atoms-maintenance.local,https://sakti.local

# ─────── MAINTENANCE ───────
MAINTENANCE_DOMAIN=atoms-maintenance.local
MAINTENANCE_PUBLIC_URL=https://atoms-maintenance.local
MAINTENANCE_PUBLIC_API_URL=https://atoms-maintenance.local/api
MAINTENANCE_CORS_ALLOWED_ORIGINS=https://atoms-maintenance.local,https://atoms.local

# ─────── SAKTI ───────
SAKTI_DOMAIN=sakti.local
SAKTI_PUBLIC_URL=https://sakti.local

# ─────── APP KEYS ───────
ROSTERING_APP_KEY=base64:CHANGE_ME
MAINTENANCE_APP_KEY=base64:CHANGE_ME
SAKTI_APP_KEY=base64:CHANGE_ME

# ─────── ROSTERING DB ───────
ROSTERING_DB_DATABASE=rostering
ROSTERING_DB_USERNAME=rostering
ROSTERING_DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ─────── MAINTENANCE DB ───────
MAINTENANCE_DB_DATABASE=atoms
MAINTENANCE_DB_USERNAME=atoms
MAINTENANCE_DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ─────── SAKTI DB ───────
SAKTI_DB_DATABASE=sakti
SAKTI_DB_USERNAME=sakti
SAKTI_DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ─────── MISC ───────
GEMINI_API_KEY=

# ─────── ALIAS LAMA (ATOMS_*) — backward-compat, bisa dihapus setelah migrasi ───────
# ATOMS_DOMAIN=atoms-maintenance.example.com
# ATOMS_PUBLIC_URL=https://atoms-maintenance.example.com
# ATOMS_PUBLIC_API_URL=https://atoms-maintenance.example.com/api
# ATOMS_CORS_ALLOWED_ORIGINS=https://atoms-maintenance.example.com,https://atoms.example.com
# ATOMS_APP_KEY=base64:CHANGE_ME
# ATOMS_DB_DATABASE=atoms
# ATOMS_DB_USERNAME=atoms
# ATOMS_DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
